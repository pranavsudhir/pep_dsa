class Solution {
public:
    int maximumPossibleSize(vector<int>& nums) {
        int n = nums.size();
        
        int count = 0;
        int currentMax = 0;
        
        for(int i = 0; i < n; i++) {
            if(nums[i] >= currentMax) {
                count++;
                currentMax = nums[i];
            }
        }
        
        return count;
    }
};
