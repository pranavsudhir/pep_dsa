class Solution {
public:
    bool findsum(TreeNode* root, int k, unordered_set<int> &s){
        if(root == NULL) return false;
        
        if(s.count(k - root->val)) return true;
        s.insert(root->val);   
        return findsum(root->left, k, s) || findsum(root->right, k, s);
    }
    bool findTarget(TreeNode* root, int k) {
        unordered_set<int> s;
        return findsum(root, k, s);
    }
};
