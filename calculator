#include <iostream>
using namespace std;

int main()
{
    int a, b;
    char op;

    cin >> a >> b;
    cin >> op;

    if (op == '+')
        cout << a + b;
    else if (op == '-')
        cout << a - b;
    else if (op == '*')
        cout << a * b;
    else if (op == '/')
        cout << a / b;
    else
        cout << "Invalid operator";

    return 0;
}
